#!/usr/bin/env bash
# tradingview CLI wrapper — run the CLI from anywhere.
#
#   tradingview candles BTCUSD --tf 1D --count 30
#   tradingview candles USDT.D --tf 4h --from -30d
#   tradingview candles BINANCE:BTCUSDT --tf 1h --count 24 --cache ~/tv.sqlite
#
# Dependencies (the @mathieuc/tradingview library) must be installed once:
#   (cd "$(dirname "$0")/.." && npm install)
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ ! -d "$DIR/node_modules/@mathieuc/tradingview" ]; then
  echo "tradingview: dependencies missing — run: (cd \"$DIR\" && npm install)" >&2
  exit 69
fi

MAJOR="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || echo 0)"
MINOR="$(node -p 'Number(process.versions.node.split(".")[1])' 2>/dev/null || echo 0)"
if [ "$MAJOR" -lt 22 ] || { [ "$MAJOR" -eq 22 ] && [ "$MINOR" -lt 13 ]; }; then
  echo "tradingview: Node >= 22.13 required (found $(node -v 2>/dev/null || echo none)); the CLI runs TypeScript directly and uses node:sqlite." >&2
  exit 69
fi

exec node "$DIR/cli.ts" "$@"
